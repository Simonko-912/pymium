#
# Pymium 0005: install window.python in every main-world context. This is a
# REFERENCE hunk -- `script_extensions.cc` differs between revisions, so apply
# with `git apply --3way` and re-place the two added lines next to the
# extension installation that runs for the main world. The implementation it
# calls lives in 0002 (python_js.{h,cc}).

diff --git a/third_party/blink/renderer/bindings/core/v8/script_extensions.cc b/third_party/blink/renderer/bindings/core/v8/script_extensions.cc
--- a/third_party/blink/renderer/bindings/core/v8/script_extensions.cc
+++ b/third_party/blink/renderer/bindings/core/v8/script_extensions.cc
@@ -90,6 +90,9 @@
   if (world.IsMainWorld()) {
     V8PerIsolateData::From(isolate)->SetScriptState(...);
   }
+  if (world.IsMainWorld()) {
+    InstallPythonJS(isolate, context->Global());
+  }
   return ScriptState::Create(...);
 }